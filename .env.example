DATABASE_URL=              # 앱(런타임)이 쓰는 DB 주소. Supabase에서는 트랜잭션 풀러(포트 6543) 주소
DIRECT_URL=                # 마이그레이션(prisma migrate) 전용 주소. 비우면 DATABASE_URL. Supabase에서는 세션 풀러(포트 5432) 주소
DATABASE_POOL_MAX=         # 인스턴스당 DB 연결 수 (기본: Vercel 5, 그 밖 10)
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=                 # 기본 us-east-1
S3_PUBLIC_ENDPOINT=        # 브라우저가 접근하는 스토리지 주소 (presigned URL용). 비우면 S3_ENDPOINT. compose에서는 http://localhost:9000
STORAGE_LOCAL_DIR=         # S3_BUCKET·S3_ACCESS_KEY·S3_SECRET_KEY가 없으면 로컬 파일 드라이버 사용 (기본 .data/storage, 개발·테스트용)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=              # 운영(NODE_ENV=production)에서 비우면 메일 로그인이 꺼진다. 개발에서 비우면 매직링크를 서버 로그에 남긴다
EMAIL_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
EMBEDDING_PROVIDER=        # 비우면 trigram 검색만 사용
EMBEDDING_API_KEY=
AI_DAILY_LIMIT_PER_USER=100
# 에디터 글쓰기 자동완성 (POST /api/ai/autocomplete). ANTHROPIC_API_KEY만 있으면 켜진다(ANTHROPIC_MODEL과 별개).
ANTHROPIC_AUTOCOMPLETE_MODEL=        # 자동완성 모델 ID. 비우면 claude-haiku-5-5 (가장 빠른 등급). 지연·비용 때문에 Haiku 등급을 권장
RATE_LIMIT_AUTOCOMPLETE_PER_MINUTE=  # 사용자당 분당 자동완성 요청 한도 (기본 20)
AI_AUTOCOMPLETE_DAILY_LIMIT=         # 사용자당 하루 자동완성 요청 한도, 한국 시간 0시 기준 (기본 300). AI_DAILY_LIMIT_PER_USER와 따로 센다
MAX_UPLOAD_MB=50
NEXT_PUBLIC_APP_NAME=Re;Note
AUTH_TEST_MODE=            # 1이면 이메일만으로 로그인하는 테스트 로그인 활성화 (개발·E2E 전용, 운영에서 절대 켜지 말 것)
TEST_DATABASE_URL=         # 통합 테스트용 DB (기본: localhost의 researchmate_test)
AI_FAKE=                   # 1이면 실제 AI 대신 정해진 가짜 응답을 낸다 (E2E 테스트 전용, 운영에서 절대 켜지 말 것. NODE_ENV=production에서는 무시됨)

# 배포 환경별 기능 (lib/features.ts). 1 또는 0. 비우면 Vercel(VERCEL=1)에서는 꺼지고 그 밖에서는 켜진다.
SERVER_CONVERSION=         # 서버(워커)에서 HWP 변환·파일 가져오기. 끄면 /api/convert·/api/import가 501 (HWP는 브라우저에서 열기)
PDF_EXPORT=                # 서버 Chromium으로 PDF 내보내기. 끄면 PDF 내보내기가 501이고 에디터에서 PDF 항목이 숨겨진다

# 변환 워커 (P3-2)
CONVERSION_QUEUE=          # bullmq | inline. 비우면 REDIS_URL이 있을 때 bullmq, 없으면 inline(웹 프로세스가 직접 처리, 개발용)
QUEUE_PREFIX=              # BullMQ 키 prefix (기본 rm)
WORKER_CONCURRENCY=        # 워커 동시 처리 수 (기본 2)
CONVERSION_TIMEOUT_MS=     # 작업당 제한 시간 (기본 120000)
CONVERSION_ENGINES_HWP=    # .hwp 엔진 순서 (기본 pyhwp,libreoffice,rhwp)
CONVERSION_ENGINES_HWPX=   # .hwpx 엔진 순서 (기본 libreoffice,rhwp)
SOFFICE_BIN=               # 엔진 실행 파일 경로 (기본: PATH의 soffice / hwp5odt / hwp5html / pdfinfo / pdftotext / pdftohtml / python3)
HWP5ODT_BIN=
HWP5HTML_BIN=
PDFINFO_BIN=
PDFTOTEXT_BIN=
PDFTOHTML_BIN=
UNHWP_PYTHON=              # unhwp가 설치된 python 실행 파일
CONVERSION_IMPORT_ENGINES_HWP=  # HWP/HWPX 가져오기 엔진 순서 (기본 unhwp,hwp5html)
UNHWP_ENGINE_SCRIPT=       # 기본 worker/engines/unhwp-extract.py
RHWP_ENGINE_SCRIPT=        # 기본 worker/engines/rhwp-pdf.mjs
NODE_BIN=                  # rhwp 엔진을 돌릴 node (기본: 현재 node)
RATE_LIMIT_UPLOAD_PER_MINUTE=   # 사용자당 업로드 URL 발급 한도 (기본 60)
RATE_LIMIT_CONVERT_PER_HOUR=    # IP(또는 사용자)당 변환·가져오기 요청 한도 (기본 20)
RATE_LIMIT_UPLOAD_PER_MINUTE=    # 사용자당 1분 업로드 횟수 (기본 60)
RATE_LIMIT_EXPORT_PER_MINUTE=    # 사용자당 1분 문서 내보내기 횟수 (기본 10, PDF는 Chromium 실행)
RATE_LIMIT_AUTH_PER_10_MIN=      # IP당 10분 로그인 시도 횟수 (기본 30)
RATE_LIMIT_SEARCH_PER_MINUTE=    # IP당 1분 검색 API 호출 횟수 (기본 60)
RATE_LIMIT_WRITE_PER_MINUTE=     # 사용자당 1분 쓰기 요청 횟수 (기본 120, 문서 자동 저장은 따로 셈)
